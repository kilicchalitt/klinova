# Copy to .env and adjust. Never commit the .env file.

# Port published on the host.
KLINOVA_PORT=8080

# Initial administrator. Leave the password empty to have a random one generated
# and printed once in the container log (docker compose logs klinova).
KLINOVA_ADMIN_USER=admin
KLINOVA_ADMIN_PASSWORD=

# Create sample polyclinics, physicians, patients and demo users (true/false).
KLINOVA_DEMO_DATA=false

# Shared password of the demo users 'kabul', 'hekim' and 'vezne'.
# Leave empty to have a random one printed once in the log.
KLINOVA_DEMO_PASSWORD=

KLINOVA_TIMEZONE=Europe/Istanbul

# Only for docker-compose.sqlserver.yml — choose a strong password.
MSSQL_SA_PASSWORD=
