@page "{visitId:int}"
@model Klinova.Web.Pages.Billing.PayModel
@{
    var v = Model.Visit;
    ViewData["Title"] = "Tahsilat";
}
<partial name="_PageHeader" model='new PageHeaderModel("Tahsilat", $"{v.Patient!.FullName} · {v.Polyclinic!.Name} · {v.VisitDate.ShortDate()}")' />

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Hizmet Dökümü</div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead><tr><th>Hizmet</th><th class="text-end">Adet</th><th class="text-end">Birim</th><th class="text-end">Tutar</th></tr></thead>
                    <tbody>
                        @foreach (var item in v.Items.OrderBy(i => i.Id))
                        {
                            <tr><td>@item.ServiceName</td><td class="text-end">@item.Quantity</td><td class="text-end font-monospace-num">@item.UnitPrice.Money()</td><td class="text-end font-monospace-num">@item.LineTotal.Money()</td></tr>
                        }
                    </tbody>
                    <tfoot><tr><th colspan="3" class="text-end">Brüt Toplam</th><th class="text-end font-monospace-num">@v.TotalAmount.Money()</th></tr></tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><i class="bi bi-cash-coin me-2"></i>Ödeme</div>
            <div class="card-body">
                @if (v.Status != VisitStatus.Completed)
                {
                    <div class="alert alert-warning mb-0">Tahsilat için muayenenin tamamlanmış olması gerekir.</div>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Method" class="form-label"></label>
                            <select asp-for="Input.Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Discount" class="form-label"></label>
                            <input asp-for="Input.Discount" type="number" min="0" max="@v.TotalAmount.ToString(CultureInfo.InvariantCulture)" step="0.01" class="form-control" value="@Model.Input.Discount.ToString(CultureInfo.InvariantCulture)" />
                            <span asp-validation-for="Input.Discount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Note" class="form-label"></label>
                            <input asp-for="Input.Note" class="form-control" placeholder="Örn. Personel indirimi" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-lg"><i class="bi bi-check2-circle me-1"></i>@v.TotalAmount.Money() Tahsil Et</button>
                        <div class="form-text text-center">İndirim, brüt tutardan düşülür.</div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
