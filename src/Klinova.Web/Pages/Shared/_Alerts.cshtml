@if (TempData[Alerts.SuccessKey] is string success)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="status">
        <i class="bi bi-check-circle-fill me-2"></i><div>@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
@if (TempData[Alerts.ErrorKey] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
