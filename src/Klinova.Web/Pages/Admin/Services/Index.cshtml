@page
@model Klinova.Web.Pages.Admin.Services.IndexModel
@{
    ViewData["Title"] = "Fiyat Listesi";
}
<div class="page-header">
    <div><h1 class="page-title">Fiyat Listesi</h1><p class="page-subtitle">Fiyat değişiklikleri yalnızca yeni eklenen hizmetlere yansır; geçmiş başvurular eklendikleri andaki fiyatı korur.</p></div>
    <a asp-page="Edit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni Hizmet</a>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Kod</th><th>Hizmet</th><th>Kategori</th><th class="text-end">Birim Fiyat</th><th>Durum</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr data-href="@Url.Page("Edit", new { id = s.Id })">
                        <td class="font-monospace-num">@s.Code</td>
                        <td class="fw-medium">@s.Name</td>
                        <td>@s.Category.OrDash()</td>
                        <td class="text-end font-monospace-num">@s.UnitPrice.Money()</td>
                        <td>@if (s.IsActive) { <span class="badge text-bg-success">Aktif</span> } else { <span class="badge text-bg-secondary">Pasif</span> }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
