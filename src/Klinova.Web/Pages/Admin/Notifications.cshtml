@page
@model Klinova.Web.Pages.Admin.NotificationsModel
@using Klinova.Domain.Notifications
@{
    ViewData["Title"] = "Bildirimler";
}
<div class="page-header">
    <div><h1 class="page-title">Bildirimler</h1><p class="page-subtitle">Hastalara gönderilen randevu onayı, hatırlatma, iptal ve bekleme listesi mesajları. SMS/e-posta sağlayıcısı yapılandırılmamışsa mesajlar yalnızca kaydedilir.</p></div>
    <form method="post" asp-page-handler="Dispatch"><button class="btn btn-outline-primary"><i class="bi bi-send me-1"></i>Bekleyenleri Şimdi Gönder</button></form>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(Model.Status is null ? "btn-primary" : "btn-light")" asp-route-status="">Tümü</a>
    @foreach (var s in Enum.GetValues<NotificationStatus>())
    {
        <a class="btn btn-sm @(Model.Status == s ? "btn-primary" : "btn-light")" asp-route-status="@s">@s.DisplayName() <span class="badge text-bg-secondary">@(Model.Counts.TryGetValue(s, out var c) ? c : 0)</span></a>
    }
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Zaman</th><th>Tür</th><th>Kanal / Alıcı</th><th>Mesaj</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-body-secondary py-4">Bildirim yok.</td></tr> }
                @foreach (var n in Model.Items)
                {
                    <tr>
                        <td class="small text-nowrap">@Clock.ToLocal(n.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                        <td class="small">@n.Type.DisplayName()</td>
                        <td class="small">@n.Channel.DisplayName()<div class="text-body-secondary">@n.Recipient</div></td>
                        <td class="small"><details><summary>@n.Subject</summary><div class="mt-1">@n.Body</div></details></td>
                        <td>
                            <span class="badge rounded-pill @(n.Status switch { NotificationStatus.Sent => "text-bg-success", NotificationStatus.Failed => "text-bg-danger", _ => "text-bg-warning" })">@n.Status.DisplayName()</span>
                            @if (n.LastError is not null) { <div class="small text-danger">@n.LastError</div> }
                        </td>
                        <td class="text-end">
                            @if (n.Status == NotificationStatus.Failed)
                            {
                                <form method="post" asp-page-handler="Retry" asp-route-status="@Model.Status"><input type="hidden" name="id" value="@n.Id" /><button class="btn btn-sm btn-light">Tekrar Dene</button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
