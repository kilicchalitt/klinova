@page "{id:int?}"
@model Klinova.Web.Pages.Admin.Doctors.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Yeni Hekim" : "Hekimi Düzenle";
}
<partial name="_PageHeader" model='new PageHeaderModel((string)ViewData["Title"]!)' />
<div class="card col-lg-8">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" list="titles" placeholder="Uzm. Dr." />
                    <datalist id="titles"><option value="Dr."></option><option value="Uzm. Dr."></option><option value="Op. Dr."></option><option value="Doç. Dr."></option><option value="Prof. Dr."></option></datalist>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.FirstName" class="form-label required-mark"></label>
                    <input asp-for="Input.FirstName" class="form-control" autofocus />
                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.LastName" class="form-label required-mark"></label>
                    <input asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PolyclinicId" class="form-label required-mark"></label>
                    <select asp-for="Input.PolyclinicId" class="form-select">
                        <option value="0">Seçiniz…</option>
                        @foreach (var p in Model.Polyclinics) { <option value="@p.Id">@p.Name</option> }
                    </select>
                    <span asp-validation-for="Input.PolyclinicId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.RegistrationNumber" class="form-label"></label>
                    <input asp-for="Input.RegistrationNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Phone" class="form-label"></label>
                    <input asp-for="Input.Phone" class="form-control" />
                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.UserId" class="form-label"></label>
                    <select asp-for="Input.UserId" class="form-select">
                        <option value="">Bağlı değil</option>
                        @foreach (var a in Model.Accounts) { <option value="@a.Id">@a.Name</option> }
                    </select>
                    <div class="form-text">Listede yalnızca "Hekim" rolündeki aktif kullanıcılar görünür.</div>
                </div>
                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input asp-for="Input.IsActive" class="form-check-input" role="switch" />
                        <label asp-for="Input.IsActive" class="form-check-label">Görevde</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Kaydet</button>
                <a asp-page="Index" class="btn btn-link">Vazgeç</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
