@page
@model Klinova.Web.Pages.Portal.ProfileModel
@{
    ViewData["Title"] = "Profilim";
    var p = Model.Patient;
}
<div class="page-header"><div><h1 class="page-title">Profilim</h1><p class="page-subtitle">Randevu bildirimleri bu iletişim bilgilerine gönderilir.</p></div></div>
<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Kimlik Bilgileri</div>
            <div class="card-body">
                <dl class="dl-compact mb-0">
                    <dt>Ad Soyad</dt><dd>@p.FullName</dd>
                    <dt>T.C. Kimlik No</dt><dd class="font-monospace-num">@(p.NationalId is { Length: 11 } id ? id[..3] + "*****" + id[^3..] : "—")</dd>
                    <dt>Doğum Tarihi</dt><dd>@p.BirthDate.ShortDate()</dd>
                    <dt>Dosya No</dt><dd class="font-monospace-num">@p.FileNumber</dd>
                </dl>
                <p class="small text-body-secondary mt-3 mb-0">Kimlik bilgilerinizdeki hatalar için hasta kabul birimine başvurunuz.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">İletişim Bilgileri</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Phone" class="form-label required-mark"></label>
                        <input asp-for="Input.Phone" class="form-control" inputmode="tel" />
                        <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Address" class="form-label"></label>
                        <textarea asp-for="Input.Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Kaydet</button>
                        <a asp-page="/Account/ChangePassword" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Şifre Değiştir</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
