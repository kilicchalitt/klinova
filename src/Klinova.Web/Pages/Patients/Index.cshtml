@page
@model Klinova.Web.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Hastalar";
    var canRegister = User.IsInAnyRole(Roles.Admin, Roles.Reception);
    var today = Clock.Today;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Hastalar</h1>
        <p class="page-subtitle">Ad soyad, dosya no, T.C. Kimlik No veya telefon ile arayın.</p>
    </div>
    @if (canRegister)
    {
        <a asp-page="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Yeni Hasta Kaydı</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center" role="search">
            <div class="col-md">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input name="q" value="@Model.Term" class="form-control" placeholder="Örn. Ayşe Yıldız, 00000012, 10000000146" autofocus aria-label="Hasta ara" />
                </div>
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="archived" value="true" id="archived" @(Model.IncludeArchived ? "checked" : "") />
                    <label class="form-check-label" for="archived">Arşivdekileri göster</label>
                </div>
            </div>
            <div class="col-auto"><button class="btn btn-primary" type="submit">Ara</button></div>
        </form>
    </div>
</div>

<div class="card">
    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-person-x"></i>
            @(string.IsNullOrWhiteSpace(Model.Term) ? "Henüz kayıtlı hasta yok." : "Aramanızla eşleşen hasta bulunamadı.")
            @if (canRegister)
            {
                <div class="mt-3"><a asp-page="Create" class="btn btn-outline-primary btn-sm">Yeni hasta kaydı oluştur</a></div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Dosya No</th><th>Ad Soyad</th><th>T.C. Kimlik No</th><th>Yaş</th><th>Telefon</th><th>Güvence</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Result.Items)
                    {
                        var age = p.BirthDate is { } b ? new Patient { BirthDate = b }.AgeOn(today) : null;
                        <tr data-href="@Url.Page("Details", new { id = p.Id })">
                            <td class="font-monospace-num">@p.FileNumber</td>
                            <td class="fw-medium">
                                @p.FullName
                                @if (p.IsArchived) { <span class="badge text-bg-secondary ms-1">Arşiv</span> }
                            </td>
                            <td class="font-monospace-num">@p.NationalId.OrDash()</td>
                            <td>@(age?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                            <td>@p.Phone.OrDash()</td>
                            <td>@p.InsuranceType.DisplayName()</td>
                            <td class="text-end text-nowrap">
                                @if (canRegister && !p.IsArchived)
                                {
                                    <a asp-page="/Visits/Admit" asp-route-patientId="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-clipboard-plus me-1"></i>Kabul</a>
                                }
                                <a asp-page="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light">Detay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pager" model='new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, p => Url.Page("Index", new { q = Model.Term, archived = Model.IncludeArchived, page = p })!)' />
