@page
@model Klinova.Web.Pages.Account.ChangePasswordModel
@{
    Layout = User.IsInRole(Roles.Patient) ? "_PortalLayout" : "_Layout";
    ViewData["Title"] = "Şifre Değiştir";
}
<partial name="_PageHeader" model='new PageHeaderModel("Şifre Değiştir", "Şifreniz en az 8 karakter olmalı; büyük harf, küçük harf ve rakam içermelidir.")' />

@if (Model.IsMandatory)
{
    <div class="alert alert-warning"><i class="bi bi-shield-exclamation me-2"></i>Güvenliğiniz için devam etmeden önce geçici şifrenizi değiştirmeniz gerekiyor.</div>
}

<div class="card col-lg-6">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Input.CurrentPassword" class="form-label required-mark"></label>
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label required-mark"></label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label required-mark"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Şifreyi Değiştir</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
