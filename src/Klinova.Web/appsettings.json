{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=data/klinova.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Klinova": {
    "TimeZone": "Europe/Istanbul",
    "ApplyMigrationsOnStartup": true,
    "UseHttpsRedirection": true,
    "LoginRequestsPerMinute": 20,
    "DataProtectionKeysPath": "data/keys",
    "KnownProxies": [],
    "Appointments": {
      "BookingHorizonDays": 30,
      "StaffBookingHorizonDays": 90,
      "MinimumLeadMinutes": 60,
      "MaxActivePerPatient": 5,
      "MaxActivePerPolyclinic": 1,
      "CancellationDeadlineHours": 2,
      "NoShowRestrictionDays": 15,
      "NoShowsForGlobalRestriction": 2,
      "ReminderHoursBefore": 24,
      "MaxWaitlistEntriesPerPatient": 3,
      "WaitlistNotifyCount": 3
    },
    "Notifications": {
      "Email": {
        "Enabled": false,
        "Host": "",
        "Port": 587,
        "EnableSsl": true,
        "UserName": "",
        "Password": "",
        "From": "",
        "FromName": "Klinova"
      },
      "Sms": {
        "Provider": "Log",
        "WebhookUrl": "",
        "ApiKey": ""
      }
    },
    "BackgroundJobs": {
      "Enabled": true,
      "NotificationIntervalSeconds": 30,
      "MaintenanceIntervalMinutes": 10
    },
    "Seed": {
      "AdminUserName": "admin",
      "AdminEmail": "admin@klinova.local",
      "AdminPassword": "",
      "DemoData": false,
      "DemoPassword": ""
    }
  }
}
